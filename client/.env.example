# ---- Client environment (copy to client/.env for local development) ----
# VITE_* values are bundled into the public website: NEVER put secrets here.

# Leave EMPTY for local development (Vite proxies /api to http://localhost:5000) and for the single-project
# Vercel deployment (the API is on the same domain). Set only if the API lives on another domain,
# e.g. https://api.example.com/api
VITE_API_URL=

# Contact and social links shown on the site (demo values). WhatsApp number: digits only, with country code.
VITE_WHATSAPP_NUMBER=447700900123
VITE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=London+EC1A+1AA
# Optional Google Maps embed URL (Share -> Embed a map -> copy the src="..." value). Empty = link only.
VITE_MAPS_EMBED_URL=
VITE_INSTAGRAM_URL=https://www.instagram.com/
VITE_FACEBOOK_URL=https://www.facebook.com/
VITE_TIKTOK_URL=https://www.tiktok.com/
