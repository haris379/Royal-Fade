# ---- Server environment (copy to server/.env for local development) ----
# On Vercel, set the same names in Project Settings -> Environment Variables. NEVER commit a real .env file.

# Local only (Vercel ignores PORT)
PORT=5000
NODE_ENV=development

# MongoDB Atlas (or local MongoDB) connection string. Include the database name, e.g. .../royal-fade
# Atlas: Network Access must allow Vercel (use 0.0.0.0/0), and the user needs readWrite + index creation rights.
MONGODB_URI=mongodb://127.0.0.1:27017/royal-fade

# Signs login sessions. REQUIRED, 32+ random characters. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Optional separate key (32+ chars) for hashing one-time email codes. Defaults to JWT_SECRET.
OTP_SECRET=

# Business owner account, used ONLY by `npm run seed` (password 10+ characters)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# REQUIRED for booking: customers must verify their email with a one-time code, so SMTP must work.
# Local testing: Mailpit (SMTP_HOST=localhost SMTP_PORT=1025) or an Ethereal account.
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Royal Fade <no-reply@example.com>"
# Where contact-form messages are emailed (they are always saved in the dashboard too)
OWNER_EMAIL=

# Extra browser origins allowed to call the API cross-origin (comma separated).
# Not needed on Vercel when site and API share one project. Needed only if the frontend runs elsewhere.
CLIENT_ORIGIN=http://localhost:5173

# Optional: where rate-limit counters live. "mongo" (default on Vercel) or "memory" (default locally).
RATE_LIMIT_STORE=

# Optional demo business details used in emails (defaults are in server/config/business.js)
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=

# Used only by `npm run create-developer` for a non-interactive run. Normally leave both unset:
# the command asks for them in the terminal with a hidden password prompt.
# DEVELOPER_EMAIL=
# DEVELOPER_PASSWORD=
